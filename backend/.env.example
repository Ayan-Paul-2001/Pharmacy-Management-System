FINGERPRINT_SERVER_API_KEY=your-fingerprintjs-server-api-key
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Mediflow Pharmacy
WEBAUTHN_ORIGIN=http://localhost:3000
